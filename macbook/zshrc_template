# Proxy for Claude Code
# 1. Configuration for your specific tunnel
export CLAUDE_PROXY_HOST="127.0.0.1"
export CLAUDE_SOCKS_PORT=1080   # Your ssh -D port
export CLAUDE_HTTP_PORT=8123    # Local http proxy port

# 2. Function to start the bridge and set vars
function claude-on() {
    echo "🌐 Starting HTTP-to-SOCKS bridge..."
    # Start bridge in background silently
    hpts -s 127.0.0.1:$CLAUDE_SOCKS_PORT -p $CLAUDE_HTTP_PORT &!
    
    # Set proxy variables strictly for this shell
    export HTTP_PROXY="http://127.0.0.1:$CLAUDE_HTTP_PORT"
    export HTTPS_PROXY="http://127.0.0.1:$CLAUDE_HTTP_PORT"
    
    echo "✅ Claude Code proxy ENABLED (Port $CLAUDE_HTTP_PORT -> SOCKS $CLAUDE_SOCKS_PORT)"
}

# 3. Function to clear vars and kill bridge
function claude-off() {
    unset HTTP_PROXY
    unset HTTPS_PROXY
    
    # Kill the background hpts process
    pkill -f "http-proxy-to-socks.*$CLAUDE_HTTP_PORT"
    
    echo "❌ Claude Code proxy DISABLED"
}

# Start LiteLLM proxy for Claude Code + NVIDIA
function litellm-start() {
    cd ~/Documents/projects/clawdbot_setup
    source .venv/bin/activate
    export $(grep -v '^#' .env | xargs)
    nohup litellm --config litellm_config.yaml --port 4000 > /tmp/litellm.log 2>&1 &
    echo "LiteLLM proxy started on port 4000"
}

function litellm-stop() {
    pkill -f "litellm.*--port 4000"
    echo "LiteLLM proxy stopped"
}

