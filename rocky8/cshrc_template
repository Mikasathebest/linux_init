if ($?DISPLAY) then
    if (`echo $DISPLAY | cut -d : -f1` == "127.0.0.1") then
        #XWin live session
        setenv DISPLAY $HOST\:`echo $DISPLAY | cut -d : -f2`
    endif
    if (`echo $DISPLAY | cut -c1` == ":") then
        #Vnc session
        setenv DISPLAY $HOST$DISPLAY
    endif
    if (`echo $DISPLAY | cut -d : -f1` == "localhost") then
        #Vnc session
        setenv DISPLAY $HOST\:`echo $DISPLAY | cut -d : -f2`
    endif
    /usr/bin/xhost + >& /dev/null
endif
